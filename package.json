{
  "name": "aws-pro",
  "version": "1.0.0",
  "description": "AWS Lightsail / EC2 / 区域 / 配额 / 账单 / 新手任务管理面板（Node.js 版）",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx watch src/server.ts --port 3023",
    "dev:server:debug": "tsx watch src/server.ts --port 3023 --log-level info | pino-pretty",
    "dev:web": "npm --workspace aws-pro-web run dev",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js --port 2023",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup src/server.ts --format esm --out-dir dist --target node20 --clean",
    "build:web": "npm --workspace aws-pro-web run build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"web/src/**/*.{ts,js,vue}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --workspace aws-pro-web run typecheck",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:web && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-account": "^3.758.0",
    "@aws-sdk/client-budgets": "^3.758.0",
    "@aws-sdk/client-cost-explorer": "^3.758.0",
    "@aws-sdk/client-ec2": "^3.758.0",
    "@aws-sdk/client-iam": "^3.758.0",
    "@aws-sdk/client-lambda": "^3.758.0",
    "@aws-sdk/client-lightsail": "^3.758.0",
    "@aws-sdk/client-rds": "^3.758.0",
    "@aws-sdk/client-service-quotas": "^3.758.0",
    "@aws-sdk/client-sts": "^3.758.0",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "keywords": [
    "aws",
    "lightsail",
    "ec2",
    "billing",
    "quota",
    "panel"
  ],
  "license": "MIT"
}
