{
  "name": "aws-pro",
  "version": "1.0.0",
  "description": "AWS Lightsail / EC2 / 区域 / 配额 / 账单 / 新手任务管理面板（Node.js 版）",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx watch src/server.ts --port 3023",
    "dev:server:debug": "tsx watch src/server.ts --port 3023 --log-level info | pino-pretty",
    "dev:web": "npm --workspace aws-pro-web run dev",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js --port 2023",
    "build": "npm run build:server && npm run build:web",
    "build:server": "rm -rf dist && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --target=node22 --sourcemap --outfile=dist/server.js",
    "build:web": "npm --workspace aws-pro-web run build",
    "lint": "eslint src web/src",
    "lint:fix": "eslint src web/src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"web/src/**/*.{ts,js,vue}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,mjs}\" \"web/*.json\"",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --workspace aws-pro-web run typecheck",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:web && npm run arch && npm run deadcode && npm run deps:check && npm run routes:check && npm run probe:contracts && npm run probe:functional && npm run build && npm run probe:static",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/src/**/*.{ts,js,vue}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,mjs}\" \"web/*.json\"",
    "arch": "node scripts/check-architecture.mjs",
    "deadcode": "knip --include files,dependencies,unlisted,unresolved --treat-config-hints-as-errors",
    "deps:check": "node scripts/check-dependencies.mjs && npm audit --omit=dev --audit-level=high",
    "routes:manifest": "tsx scripts/generate-route-manifest.ts",
    "routes:check": "tsx scripts/generate-route-manifest.ts --check",
    "probe:contracts": "tsx scripts/isolated-sensitive-files-probe.ts && tsx scripts/isolated-account-integrity-probe.ts && tsx scripts/isolated-aws-cache-probe.ts && tsx scripts/isolated-newbie-reliability-probe.ts && tsx scripts/isolated-api-boundary-probe.ts && tsx scripts/isolated-frontend-ownership-probe.ts",
    "probe:functional": "tsx scripts/isolated-functional-surface-probe.ts",
    "probe:static": "tsx scripts/isolated-static-probe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-account": "^3.758.0",
    "@aws-sdk/client-budgets": "^3.758.0",
    "@aws-sdk/client-cost-explorer": "^3.758.0",
    "@aws-sdk/client-ec2": "^3.758.0",
    "@aws-sdk/client-iam": "^3.758.0",
    "@aws-sdk/client-lambda": "^3.758.0",
    "@aws-sdk/client-lightsail": "^3.758.0",
    "@aws-sdk/client-rds": "^3.758.0",
    "@aws-sdk/client-service-quotas": "^3.758.0",
    "@aws-sdk/client-sts": "^3.758.0",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.1.0",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "@vue/compiler-sfc": "3.5.39",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "knip": "^5.88.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "keywords": [
    "aws",
    "lightsail",
    "ec2",
    "billing",
    "quota",
    "panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lei-rr/aws-pro.git"
  },
  "bugs": {
    "url": "https://github.com/lei-rr/aws-pro/issues"
  },
  "homepage": "https://github.com/lei-rr/aws-pro#readme",
  "license": "MIT"
}
